package com.construction.persistence.service;

import com.construction.appconfiguration.utils.ApplicationSecurityContext;
import com.construction.persistence.filter.FilterUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Component;

import javax.persistence.EntityManager;
import javax.persistence.PersistenceContext;
import javax.validation.constraints.NotNull;

@Component
public class AccessibleObject {

    @Autowired
    private ApplicationSecurityContext context;
    @Autowired
    private FilterUtils filterUtils;
    @PersistenceContext
    private EntityManager em;
    
    public void enablePersistenceFilter(@NotNull final String entityName){
        final var user = context.authenticatedUser();
        if(user == null){
            filterUtils.enableFilters("noAccessFilter");
        }
    }

    public <T> T getObject(@NotNull Class<T> entityType, @NotNull Long id) {
        final var entityName = entityType.getSimpleName().toUpperCase();
        final var user = context.authenticatedUser();
        if (user == null) return null; // unauthenticated return null
        if (user.hasPermissionTo("READ_ALL_" + entityName)) {
            return em.find(entityType, id);
        } else if (user.hasPermissionTo("READ_ASSIGNED_" + entityName)) {
            filterUtils.enableFilters("assignedObject");
            return em.find(entityType, id);
        } else {
            filterUtils.enableFilters("myObject");
            return em.find(entityType, id);
        }
    }
}
